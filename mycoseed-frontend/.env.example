# 复制为 .env 后填写。Vite/Nuxt 在构建时注入 NUXT_PUBLIC_* 到浏览器。

# --- Same-origin production (recommended) ---
# Leave public API URL empty; browser calls https://your-frontend/api/* and Nitro proxies to Fly.
# NUXT_PUBLIC_API_URL=
NUXT_BACKEND_URL=https://bai-backend.fly.dev
NUXT_PUBLIC_APP_URL=https://bai.ntdao.xyz

# --- Local dev (Nuxt :3003, backend :3001) ---
# NUXT_PUBLIC_API_URL=
# NUXT_BACKEND_URL=http://localhost:3001
# NUXT_PUBLIC_APP_URL=http://localhost:3003

# --- Legacy cross-origin (not recommended) ---
# NUXT_PUBLIC_API_URL=https://bai-backend.fly.dev

# --- Semi（TaskPool 跳转 / OAuth）---
NUXT_PUBLIC_SEMI_APP_URL=http://localhost:3000
NUXT_PUBLIC_SEMI_API_URL=https://semi-production.fly.dev
NUXT_PUBLIC_SEMI_OAUTH_URL=https://semi.ntdao.xyz
NUXT_PUBLIC_SEMI_CLIENT_ID=
NUXT_PUBLIC_SEMI_REDIRECT_URI=http://localhost:3003/auth/callback

# --- TaskPool（OP Mainnet chainId=10）---
NUXT_PUBLIC_TASKPOOL_PROXY_ADDRESS=0x3A612F0e8D3942fEb6E2f48AfEbaCFa5ED7bb749
NUXT_PUBLIC_TASKPOOL_ADMIN_ADDRESS=
NUXT_PUBLIC_CHAIN_ID=10
NUXT_PUBLIC_OP_RPC_URL=https://mainnet.optimism.io
NUXT_PUBLIC_NT_TOKEN_ADDRESS=0x7563cb33148cD2b929ed85e69F697be13b515Bd0
# NUXT_PUBLIC_TASKPOOL_SHOW_INJECTED_WALLET_DEMO=true

# Fly bai-backend: REDIRECT_URI=https://bai.ntdao.xyz/api/auth/semi/callback
# Semi OAuth app must register the same redirect_uri.
