# 复制为 .env 后填写。Vite/Nuxt 在构建时注入 NUXT_PUBLIC_* 到浏览器。

# --- 后端 API ---
NUXT_PUBLIC_API_URL=http://localhost:3001

# --- Semi（TaskPool 跳转 / OAuth；本地联调见 bai/scripts/taskpool-dev-up.sh）---
NUXT_PUBLIC_SEMI_APP_URL=http://localhost:3000
NUXT_PUBLIC_SEMI_API_URL=
NUXT_PUBLIC_SEMI_OAUTH_URL=
NUXT_PUBLIC_SEMI_CLIENT_ID=
NUXT_PUBLIC_SEMI_REDIRECT_URI=http://localhost:3003/auth/callback

# --- TaskPool（OP Mainnet chainId=10；须与后端 TASKPOOL_* / 合约部署一致）---
NUXT_PUBLIC_TASKPOOL_PROXY_ADDRESS=0x3A612F0e8D3942fEb6E2f48AfEbaCFa5ED7bb749
NUXT_PUBLIC_TASKPOOL_ADMIN_ADDRESS=
NUXT_PUBLIC_CHAIN_ID=10
NUXT_PUBLIC_OP_RPC_URL=https://mainnet.optimism.io
NUXT_PUBLIC_NT_TOKEN_ADDRESS=0x7563cb33148cD2b929ed85e69F697be13b515Bd0

# 可选：管理页展示 MetaMask 建池 demo
# NUXT_PUBLIC_TASKPOOL_SHOW_INJECTED_WALLET_DEMO=true
