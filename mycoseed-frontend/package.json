    "taskpool:print-typeddata": "tsx scripts/taskpool-print-typeddata.mts",
    "taskpool:test-eip712": "tsx scripts/test-taskpool-eip712.mts",
    "taskpool:test-createpool-mock": "tsx scripts/test-taskpool-createpool-mock.mts",
    "taskpool:onchain-createpool-demo": "tsx scripts/taskpool-onchain-createpool-and-persist.mts",
    "taskpool:confirm-and-patch": "tsx scripts/taskpool-confirm-and-patch.mts",
    "taskpool:test-overall-review": "tsx scripts/test-taskpool-overall-review.mts",
    "taskpool:test-withdraw": "tsx scripts/test-taskpool-withdraw.mts",
    "taskpool:test-pool-draft": "tsx scripts/test-taskpool-pool-draft.mts",
    "taskpool:test-subtask-delete": "tsx scripts/test-taskpool-subtask-delete.mts",
    "taskpool:test-semi-prepay-callback": "tsx scripts/test-semi-prepay-callback.mts",
