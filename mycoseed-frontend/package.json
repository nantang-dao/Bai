    "typecheck": "nuxi typecheck",
    "test:e2e:auth": "PWDEBUG=1 playwright test e2e/auth.setup.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:taskpool": "playwright test e2e/taskpool-*.spec.ts --grep-invert @slow",
    "test:e2e:slow": "playwright test --grep @slow",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:taskpool-remarks": "playwright test e2e/taskpool-detail-remark-cards.spec.ts"
