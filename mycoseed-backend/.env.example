# 复制为 .env 后填写。以 # 开头的行为注释。

# --- Supabase（必填）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 服务 ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3003
FRONTEND_URLS=http://localhost:3003,https://bai.ntdao.xyz,https://bai.nanaland.xyz

# --- 阿里云短信（可选）---
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=安百
ALIYUN_SMS_TEMPLATE_CODE=SMS_478855061
SMS_ENABLED=ENABLED

# --- TaskPool 链上（与前端 NUXT_PUBLIC_* 地址一致）---
TASKPOOL_CHAIN_ID=10
TASKPOOL_PROXY_ADDRESS=
TASKPOOL_ADMIN_ADDRESS=
TASKPOOL_NT_TOKEN_ADDRESS=
OP_RPC_URL=
TASKPOOL_CLAIM_SIGNER_PRIVATE_KEY=
TASKPOOL_EXPECT_IMPL=

# --- Semi OAuth / API ---
SEMI_CLIENT_ID=
SEMI_CLIENT_SECRET=
SEMI_FRONTEND_URL=https://semi.ntdao.xyz
SEMI_BACKEND_URL=https://semi-production.fly.dev
SEMI_BACKEND_BASE_URL=
REDIRECT_URI=https://bai.ntdao.xyz/api/auth/semi/callback
SESSION_SECRET=
SEMI_OAUTH_SCOPES=openid profile wallet
SESSION_SAMESITE=Lax
SESSION_DOMAIN=
SESSION_MAX_AGE_SECONDS=

# 开发者免验登录（仅 development 生效）
DEV_BYPASS_AUTH=true
