# 复制为 .env 后填写。以 # 开头的行为注释。

# --- Supabase（必填：API 与数据库）---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- 服务 ---
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3003

# --- 阿里云短信（可选；SMS_ENABLED 非 ENABLED 时可不填）---
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
SMS_ENABLED=

# --- TaskPool 链上口径（读链 / 校验 / 脚本；与合约部署一致）---
# OP Mainnet = 10；可与前端 NUXT_PUBLIC_* 使用同一组地址
TASKPOOL_CHAIN_ID=10
TASKPOOL_PROXY_ADDRESS=
TASKPOOL_ADMIN_ADDRESS=
TASKPOOL_NT_TOKEN_ADDRESS=

# 读链 RPC：主网建议用稳定节点；可与 OP_RPC_URL 二选一或同时配置（见 src/config/taskpool.ts 优先级）
OP_RPC_URL=

# Claim 意图 EIP-712 签名私钥（32 字节 hex，带 0x）；须与链上配置的 signer 口径一致，不是地址字符串
TASKPOOL_CLAIM_SIGNER_PRIVATE_KEY=

# 可选：CI/本地脚本 checkTaskpoolProxyImplementation 校验 Proxy 实现地址是否与升级后一致
TASKPOOL_EXPECT_IMPL=

# --- Semi-backend（可选：用于终审 remark payload 临时存储 C1）---
# 本地默认 http://localhost:3000
SEMI_BACKEND_BASE_URL=
